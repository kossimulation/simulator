<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Output of `cmake -S native -B build/native`; override with -p:SimcoreNativeDir=... -->
    <SimcoreNativeDir Condition="'$(SimcoreNativeDir)' == ''">$(MSBuildThisFileDirectory)../build/native/bin/</SimcoreNativeDir>
  </PropertyGroup>
</Project>
